{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update",
        "delete"
      ],
      "entity_name": "Credential"
    }
  },
  "name": "Credential Reminder Sync",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "credential_reminder_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_reminder": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncCredentialReminder",
            "args": {
              "credential_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sync credential reminder",
            "description": "Create/update/delete the linked reminder"
          }
        }
      }
    ]
  },
  "description": "Keeps exactly one expiration reminder synced to each Credential, using the service role and the credential owner's identity."
}