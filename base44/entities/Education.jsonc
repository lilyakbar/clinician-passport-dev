{
  "name": "Education",
  "type": "object",
  "properties": {
    "degree": {
      "type": "string"
    },
    "field_of_study": {
      "type": "string"
    },
    "institution": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "completed": {
      "type": "boolean",
      "default": true
    },
    "honors": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "degree",
    "institution"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}