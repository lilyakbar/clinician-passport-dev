{
  "name": "CareerLensWorkspace",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "lens_type": {
      "type": "string"
    },
    "query": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "result_data": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}