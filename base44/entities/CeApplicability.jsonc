{
  "name": "CeApplicability",
  "type": "object",
  "properties": {
    "ce_id": {
      "type": "string"
    },
    "credential_id": {
      "type": "string"
    },
    "requirement_key": {
      "type": "string"
    },
    "credits_applied": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "ai_suggested",
        "confirmed",
        "rejected"
      ],
      "default": "ai_suggested"
    },
    "source": {
      "type": "string",
      "default": "ai"
    }
  },
  "required": [
    "ce_id",
    "credential_id",
    "requirement_key"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}