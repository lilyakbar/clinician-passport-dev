{
  "name": "ComplianceProfile",
  "type": "object",
  "properties": {
    "jurisdiction": {
      "type": "string"
    },
    "profession": {
      "type": "string",
      "default": "dentistry"
    },
    "requirements": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "official": {
      "type": "boolean",
      "default": false
    },
    "last_checked": {
      "type": "string",
      "format": "date"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified",
        "unverified"
      ],
      "default": "unverified"
    }
  },
  "required": [
    "jurisdiction",
    "profession"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}