{
  "name": "Volunteering",
  "type": "object",
  "properties": {
    "organization": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "cause": {
      "type": "string"
    },
    "hours": {
      "type": "number"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "current": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "default": "manual"
    },
    "import_batch_id": {
      "type": "string"
    },
    "source_document_name": {
      "type": "string"
    }
  },
  "required": [
    "organization",
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}