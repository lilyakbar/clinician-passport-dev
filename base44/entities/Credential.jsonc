{
  "name": "Credential",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "credential_type": {
      "type": "string"
    },
    "issuing_body": {
      "type": "string"
    },
    "license_number": {
      "type": "string"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "expiration_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expiring",
        "expired",
        "pending",
        "inactive"
      ],
      "default": "active"
    },
    "jurisdiction": {
      "type": "string"
    },
    "profession": {
      "type": "string",
      "default": "dentistry"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "credential_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}